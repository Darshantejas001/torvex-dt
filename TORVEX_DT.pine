// @version=6
indicator("TORVEX_DT", shorttitle = "TORVEX_DT", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 400)

// ============================================================================
// TORVEX TRADER SUITE (Custom Build) — SMT SWAP v2
// Modules included: Time Settings, internal Swing Structure (feeds
//                    Zones/TOB/tCISD), TORVEX Origin/Shift/Extreme Zones,
//                    Bias/CRT Table, Status Panel, QT Cycle Board (90m
//                    Quarterly Theory + AMDX/XAMD), Auto Correlation Matrix,
//                    MTF Key Levels, True Order Block (TOB), CISD & Order
//                    Flow Tools (tCISD, QCISD, per-tier HTF CISD Mirror:
//                    90m->M5, D->M15, W->H1, M->H4, Q->D, Y->W, each with
//                    its own Pending/Confirmed state, plus a Hide Confirmed
//                    tCISD/QCISD option), MSNR (Support/Resistance Flip)
//                    with OCL/CL (Open Candle/Prev Close), RB/SB (break
//                    tags), QM+/QM- (Quasimodo) levels and TS-KEY (Turtle
//                    Soup + Engulfing body-based key levels, per-timeframe
//                    with confluence -> Strong Key labeling, LIQ swept-wick
//                    lines, OCL/CL tag), HMC Auto Bias, CRT Schedule,
//                    TORVEX • SMT Divergence (multi-asset, sweep-based,
//                    Macro+Micro, with A+/A++/A+++ grading and
//                    Pending/Confirmed states), TORVEX Master Panel
//                    (SMT/Bias/CRT/HMC view), TORVEX MTF Candle Overview panel.
// Removed vs. the previous build: Funding Opens, PSP (Correlation Crack),
//   Buy/Sell TORVEX Zones, generic Order Blocks (OB) (kept True Order Block
//   only), Symmetric Levels + its QT/SSMT confluence checker (not part of
//   the reference tool), MSNR's wick/swing-anchored A/V (Anchor/Value)
//   lines (replaced by the body-based, multi-TF TS-KEY module).
// ============================================================================


gPanelSize = "TORVEX • Panel Size (Mobile / Desktop)"
panelModeIn = input.string("Mobile", "Panel Mode", options = ["Mobile", "Desktop"], group = gPanelSize, tooltip = "Mobile = bigger, easier-to-read panels for phone screens. Desktop = compact panels for large monitors.")
panelSizeOverride = input.string("Auto", "Panel Text Size Override", options = ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group = gPanelSize, tooltip = "Leave on Auto to use the Panel Mode above. Pick a fixed size here only if you want more manual control than Mobile/Desktop gives.")
f_panelSize() =>
    autoSize = panelModeIn == "Mobile" ? size.tiny : size.small
    panelSizeOverride == "Auto"   ? autoSize      :
     panelSizeOverride == "Tiny"   ? size.tiny     :
     panelSizeOverride == "Small"  ? size.small    :
     panelSizeOverride == "Normal" ? size.normal   :
     panelSizeOverride == "Large"  ? size.large    : size.huge

gTZ = "TORVEX • Time Settings"
tzInput = input.string("America/New_York", "Timezone (IANA format)", group = gTZ, tooltip = "Examples: America/New_York, Europe/London, UTC")

gHistory = "TORVEX • History / Lookback"
limitHistory       = input.bool(true, "Limit Drawings by History (Days)", group = gHistory, tooltip = "When ON, new CISD lines, TORVEX Zones, SSMT marks, PSP marks and TCISD labels only get created on bars within the chosen day range. Turn OFF to draw across all available history (older objects already on screen are unaffected either way).")
historyLookbackDays = input.int(30, "Days of History to Draw", minval = 1, group = gHistory)

f_withinLookback() =>
    not limitHistory or time >= (timenow - historyLookbackDays * 86400000)

f_lineStyle(styleStr) =>
    styleStr == "Solid" ? line.style_solid : styleStr == "Dashed" ? line.style_dashed : line.style_dotted

f_textSize(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

gStruct = "TORVEX • Swing Structure (used by Zones/TOB)"
swingFilterATR = input.float(1.0, "Valid Swing Filter (ATR mult)", minval = 0.1, step = 0.1, group = gStruct, tooltip = "A swing high/low only becomes valid once price reverses by this many ATRs from the running extreme. Higher = fewer, more significant swings (less noise). Feeds the TORVEX Zones and True Order Block modules.")

atrSwing = ta.atr(14)
var float swingExtHigh    = na
var int   swingExtHighBar = na
var int   swingExtHighTime = na
var float swingExtLow     = na
var int   swingExtLowBar  = na
var int   swingExtLowTime = na
var int   swingDir        = 0
var float lastPH    = na
var int   lastPHBar  = na
var int   lastPHTime = na
var float lastPL    = na
var int   lastPLBar  = na
var int   lastPLTime = na

if na(swingExtHigh) or high > swingExtHigh
    swingExtHigh := high
    swingExtHighBar := bar_index
    swingExtHighTime := time
if na(swingExtLow) or low < swingExtLow
    swingExtLow := low
    swingExtLowBar := bar_index
    swingExtLowTime := time

if swingDir <= 0 and close > swingExtLow + atrSwing * swingFilterATR
    lastPL := swingExtLow
    lastPLBar := swingExtLowBar
    lastPLTime := swingExtLowTime
    swingDir := 1
    swingExtHigh := high
    swingExtHighBar := bar_index
    swingExtHighTime := time
if swingDir >= 0 and close < swingExtHigh - atrSwing * swingFilterATR
    lastPH := swingExtHigh
    lastPHBar := swingExtHighBar
    lastPHTime := swingExtHighTime
    swingDir := -1
    swingExtLow := low
    swingExtLowBar := bar_index
    swingExtLowTime := time

var string swingState = "neutral"

gTorvexRange = "TORVEX TRADER - RANGE SETTINGS"
showTorvexZones      = input.bool(true, "Show TORVEX Zones", group = gTorvexRange)
showRangeMarkers = input.bool(false, "Show Range Markers + Text", group = gTorvexRange)
torvexZoneExtBars    = input.int(40, "Zone Extension (bars)", minval = 1, group = gTorvexRange)
torvexZoneHeightATR  = input.float(0.6, "Zone Height (ATR)", minval = 0.1, step = 0.1, group = gTorvexRange)
torvexOriginATR      = input.float(0.5, "Origin Offset (ATR)", minval = 0.1, step = 0.1, group = gTorvexRange)
torvexShiftATR       = input.float(1.5, "Shift Offset (ATR)",  minval = 0.1, step = 0.1, group = gTorvexRange)
torvexExtremeATR     = input.float(3.0, "Extreme Offset (ATR)", minval = 0.1, step = 0.1, group = gTorvexRange)
torvexMaxSets        = input.int(20, "Max Zone Sets Kept", minval = 1, group = gTorvexRange, tooltip = "Raise this to keep more historical TORVEX zones on the chart (worked and failed) instead of deleting the oldest ones.")

gTorvexSell = "TORVEX TRADER - SELL ZONES"
showSellTorvexZones = input.bool(true, "Show Sell TORVEX Zones", group = gTorvexSell)
sellOriginColBase  = input.color(#f6b3c9, "Origin Color", inline = "sellO", group = gTorvexSell)
sellOriginOpacity  = input.int(85, "Opacity", minval = 0, maxval = 100, inline = "sellO", group = gTorvexSell)
sellShiftColBase   = input.color(#ef5f9a, "Shift Color",  inline = "sellS", group = gTorvexSell)
sellShiftOpacity   = input.int(80, "Opacity", minval = 0, maxval = 100, inline = "sellS", group = gTorvexSell)
sellExtremeColBase = input.color(#e0384d, "Extreme Color", inline = "sellE", group = gTorvexSell)
sellExtremeOpacity = input.int(75, "Opacity", minval = 0, maxval = 100, inline = "sellE", group = gTorvexSell)

gTorvexBuy = "TORVEX TRADER - BUY ZONES"
showBuyTorvexZones = input.bool(true, "Show Buy TORVEX Zones", group = gTorvexBuy)
buyOriginColBase  = input.color(#c8f0c8, "Origin Color", inline = "buyO", group = gTorvexBuy)
buyOriginOpacity  = input.int(85, "Opacity", minval = 0, maxval = 100, inline = "buyO", group = gTorvexBuy)
buyShiftColBase   = input.color(#3fae4a, "Shift Color",  inline = "buyS", group = gTorvexBuy)
buyShiftOpacity   = input.int(80, "Opacity", minval = 0, maxval = 100, inline = "buyS", group = gTorvexBuy)
buyExtremeColBase = input.color(#1f7a2e, "Extreme Color", inline = "buyE", group = gTorvexBuy)
buyExtremeOpacity = input.int(75, "Opacity", minval = 0, maxval = 100, inline = "buyE", group = gTorvexBuy)

f_zoneCol(baseCol, opacityPct) => color.new(baseCol, 100 - opacityPct)

gTorvexVisual = "TORVEX TRADER - VISUAL SETTINGS"
torvexZoneTextCol   = input.color(#131722, "Zone Text Color", group = gTorvexVisual)
torvexZoneTextSizeIn = input.string("Small", "Zone Box Text Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = gTorvexVisual)
originZoneName  = input.string("TORVEX ORIGIN",  "Origin Zone Name",  inline = "zoneNameRow1", group = gTorvexVisual)
shiftZoneName   = input.string("TORVEX SHIFT",   "Shift Zone Name",   inline = "zoneNameRow1", group = gTorvexVisual)
extremeZoneName = input.string("TORVEX EXTREME", "Extreme Zone Name", group = gTorvexVisual)

f_zoneTextSize(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

var array<box>   torvexZoneBoxes  = array.new<box>()
var array<label> torvexZoneLabels = array.new<label>()
var array<bool>  torvexZoneTapped = array.new<bool>()
var array<bool>  torvexZoneFrozen = array.new<bool>()

f_trimTorvexZones() =>
    while array.size(torvexZoneBoxes) > torvexMaxSets * 3
        box.delete(array.shift(torvexZoneBoxes))
        label.delete(array.shift(torvexZoneLabels))
        array.shift(torvexZoneTapped)
        array.shift(torvexZoneFrozen)

f_freezeUntappedZones() =>
    if array.size(torvexZoneTapped) > 0
        for zi = 0 to array.size(torvexZoneTapped) - 1
            if not array.get(torvexZoneTapped, zi)
                array.set(torvexZoneFrozen, zi, true)

torvexZoneATR = ta.atr(14)

f_drawTorvexZoneSet(originPrice, isBull, atrZ) =>
    oCol = isBull ? f_zoneCol(buyOriginColBase, buyOriginOpacity)   : f_zoneCol(sellOriginColBase, sellOriginOpacity)
    sCol = isBull ? f_zoneCol(buyShiftColBase, buyShiftOpacity)     : f_zoneCol(sellShiftColBase, sellShiftOpacity)
    eCol = isBull ? f_zoneCol(buyExtremeColBase, buyExtremeOpacity) : f_zoneCol(sellExtremeColBase, sellExtremeOpacity)
    dir  = isBull ? 1 : -1
    right = bar_index
    lblSize = f_zoneTextSize(torvexZoneTextSizeIn)

    oNear = originPrice
    oFar  = originPrice + dir * atrZ * torvexZoneHeightATR
    oBox  = box.new(bar_index, math.max(oNear, oFar), right, math.min(oNear, oFar), border_color = oCol, bgcolor = oCol)
    oLbl  = label.new(right, (oNear + oFar) / 2, originZoneName, style = label.style_label_right, textcolor = torvexZoneTextCol, color = color.new(color.white, 100), size = lblSize)

    sNear = originPrice + dir * atrZ * torvexShiftATR
    sFar  = sNear + dir * atrZ * torvexZoneHeightATR
    sBox  = box.new(bar_index, math.max(sNear, sFar), right, math.min(sNear, sFar), border_color = sCol, bgcolor = sCol)
    sLbl  = label.new(right, (sNear + sFar) / 2, shiftZoneName, style = label.style_label_right, textcolor = torvexZoneTextCol, color = color.new(color.white, 100), size = lblSize)

    eNear = originPrice + dir * atrZ * torvexExtremeATR
    eFar  = eNear + dir * atrZ * torvexZoneHeightATR
    eBox  = box.new(bar_index, math.max(eNear, eFar), right, math.min(eNear, eFar), border_color = eCol, bgcolor = eCol)
    eLbl  = label.new(right, (eNear + eFar) / 2, extremeZoneName, style = label.style_label_right, textcolor = torvexZoneTextCol, color = color.new(color.white, 100), size = lblSize)

    array.push(torvexZoneBoxes, oBox)
    array.push(torvexZoneBoxes, sBox)
    array.push(torvexZoneBoxes, eBox)
    array.push(torvexZoneLabels, oLbl)
    array.push(torvexZoneLabels, sLbl)
    array.push(torvexZoneLabels, eLbl)
    array.push(torvexZoneTapped, false)
    array.push(torvexZoneTapped, false)
    array.push(torvexZoneTapped, false)
    array.push(torvexZoneFrozen, false)
    array.push(torvexZoneFrozen, false)
    array.push(torvexZoneFrozen, false)
    f_trimTorvexZones()

if f_withinLookback() and not na(lastPH) and close > lastPH and swingState != "bull"
    swingState := "bull"
    if showTorvexZones and showBuyTorvexZones
        f_freezeUntappedZones()
        f_drawTorvexZoneSet(lastPH, true, torvexZoneATR)

if f_withinLookback() and not na(lastPL) and close < lastPL and swingState != "bear"
    swingState := "bear"
    if showTorvexZones and showSellTorvexZones
        f_freezeUntappedZones()
        f_drawTorvexZoneSet(lastPL, false, torvexZoneATR)

if array.size(torvexZoneBoxes) > 0
    for zi = array.size(torvexZoneBoxes) - 1 to 0
        zBox = array.get(torvexZoneBoxes, zi)
        zLbl = array.get(torvexZoneLabels, zi)
        if not array.get(torvexZoneTapped, zi)
            zTop = box.get_top(zBox)
            zBot = box.get_bottom(zBox)
            if high >= zBot and low <= zTop
                array.set(torvexZoneTapped, zi, true)
            if not array.get(torvexZoneFrozen, zi)
                box.set_right(zBox, bar_index)
                label.set_x(zLbl, bar_index)

// ── (Helpers, Visual Inputs, SMT modules, Correlation etc.) ──────────────────
// For brevity this file includes the core pieces we've discussed earlier.
// Below follows the SMT / auto-detection / correlation / SSMT alignment
// modules. Paste as-is.

G_VIS = "TORVEX • Visual Inputs"
showLines = input.bool(true, "Show Lines", group = G_VIS)
bullColor = input.color(#089981, "Bull Color", group = G_VIS)
bearColor = input.color(#f23645, "Bear Color", group = G_VIS)
showLabels = input.bool(true, "Show Labels", group = G_VIS)
txtSizeInput = input.string("Small", "Label Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_VIS)
lineWidthInput = input.int(2, "Line Width", minval = 1, group = G_VIS)
lsIn1 = input.string("Solid", "Line Style - Sym 1", options = ["Solid", "Dashed", "Dotted"], group = G_VIS)
lsIn2 = input.string("Dashed", "Line Style - Sym 2", options = ["Solid", "Dashed", "Dotted"], group = G_VIS)
lsIn3 = input.string("Dotted", "Line Style - Sym 3", options = ["Solid", "Dashed", "Dotted"], group = G_VIS)

toLS(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

shortName(sym) =>
    str.contains(sym, ":") ? str.split(sym, ":").get(1) : sym

toSize(s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : s == "Huge" ? size.huge : size.small

// Auto-Detection (correlated pair/triad by chart symbol)
get_auto() =>
    string t   = syminfo.ticker
    bool isFut = syminfo.type == "futures"
    string s1  = ""
    string s2  = ""
    string s3  = ""
    bool   i1  = false
    bool   i2  = false
    bool   i3  = false

    if str.contains(t, "NQ") or str.contains(t, "NAS100") or str.contains(t, "USTEC")
        s1 := "CME_MINI:ES1!"
        s2 := "CBOT:YM1!"
        s3 := "CME_MINI:RTY1!"
    else if str.contains(t, "SPX") or str.contains(t, "SPY") or (str.contains(t, "ES") and str.contains(t, "1!"))
        s1 := "CME_MINI:NQ1!"
        s2 := "CBOT:YM1!"
        s3 := "CME_MINI:RTY1!"
    else if str.contains(t, "YM") or str.contains(t, "DJI") or str.contains(t, "DIA")
        s1 := "CME_MINI:NQ1!"
        s2 := "CME_MINI:ES1!"
        s3 := "CME_MINI:RTY1!"
    else if str.contains(t, "RTY") or str.contains(t, "RUT") or str.contains(t, "IWM")
        s1 := "CME_MINI:NQ1!"
        s2 := "CME_MINI:ES1!"
        s3 := "CBOT:YM1!"
    else if str.contains(t, "XAUUSD") or str.contains(t, "GOLD") or str.contains(t, "GC1")
        s1 := isFut ? "COMEX:SI1!" : "TVC:SILVER"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "XAGUSD") or str.contains(t, "SILVER") or str.contains(t, "SI1")
        s1 := isFut ? "COMEX:GC1!" : "TVC:GOLD"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "DXY") or str.contains(t, "USDX") or str.contains(t, "DX1")
        s1 := isFut ? "COMEX:GC1!" : "TVC:GOLD"
        s2 := isFut ? "CME:6E1!"   : "FX:EURUSD"
        i1 := true
        i2 := true
    else if str.contains(t, "EURUSD") or str.contains(t, "6E")
        s1 := isFut ? "CME:6B1!" : "FX:GBPUSD"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "GBPUSD") or str.contains(t, "6B")
        s1 := isFut ? "CME:6E1!" : "FX:EURUSD"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "AUDUSD") or str.contains(t, "6A")
        s1 := isFut ? "CME:6N1!" : "FX:NZDUSD"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "NZDUSD") or str.contains(t, "6N")
        s1 := isFut ? "CME:6A1!" : "FX:AUDUSD"
        s2 := "TVC:DXY"
        i2 := true
    else if str.contains(t, "USDJPY") or str.contains(t, "6J")
        s1 := isFut ? "CME:6E1!" : "FX:EURUSD"
        s2 := isFut ? "CME:6B1!" : "FX:GBPUSD"
        i1 := true
        i2 := true
    else if str.contains(t, "USDCHF") or str.contains(t, "6S")
        s1 := isFut ? "CME:6E1!" : "FX:EURUSD"
        s2 := "TVC:DXY"
        i1 := true
    else if str.contains(t, "USDCAD") or str.contains(t, "6C")
        s1 := "NYMEX:CL1!"
        s2 := "TVC:DXY"
        i1 := true
    else if str.contains(t, "BTC")
        s1 := "PYTH:ETHUSD"
        s2 := "PYTH:SOLUSD"
    else if str.contains(t, "ETH")
        s1 := "PYTH:BTCUSD"
        s2 := "PYTH:SOLUSD"
    else if str.contains(t, "SOL")
        s1 := "PYTH:BTCUSD"
        s2 := "PYTH:ETHUSD"
    else if str.contains(t, "USOIL") or str.contains(t, "WTIUSD") or str.contains(t, "CL1")
        s1 := "NYMEX:BZ1!"
        s2 := "NYMEX:NG1!"
    else if str.contains(t, "UKOIL") or str.contains(t, "XBRUSD") or str.contains(t, "BZ1")
        s1 := "NYMEX:CL1!"
        s2 := "NYMEX:NG1!"

    [s1, s2, s3, i1, i2, i3]

[autoS1, autoS2, autoS3, autoI1, autoI2, autoI3] = get_auto()

modeInput = input.string("Auto", "SMT Mode", options = ["Auto", "Manual"], group = "TORVEX • SMT")
manualSym1 = input.string("", "Manual Sym 1", group = "TORVEX • SMT")
manualSym2 = input.string("", "Manual Sym 2", group = "TORVEX • SMT")
manualSym3 = input.string("", "Manual Sym 3", group = "TORVEX • SMT")
manualInv1 = input.bool(false, "Invert Sym1", group = "TORVEX • SMT")
manualInv2 = input.bool(false, "Invert Sym2", group = "TORVEX • SMT")
manualInv3 = input.bool(false, "Invert Sym3", group = "TORVEX • SMT")

isAutoSMT = modeInput == "Auto"
sym1   = isAutoSMT ? autoS1 : manualSym1
sym2   = isAutoSMT ? autoS2 : manualSym2
sym3   = isAutoSMT ? autoS3 : manualSym3
inv1   = isAutoSMT ? autoI1 : manualInv1
inv2   = isAutoSMT ? autoI2 : manualInv2
inv3   = isAutoSMT ? autoI3 : manualInv3

// Data fetching examples (for main comparison symbols)
[sHigh1, sLow1] = request.security(sym1 != "" ? sym1 : syminfo.tickerid, timeframe.period, [high, low])
[sHigh2, sLow2] = request.security(sym2 != "" ? sym2 : syminfo.tickerid, timeframe.period, [high, low])
[sHigh3, sLow3] = request.security(sym3 != "" ? sym3 : syminfo.tickerid, timeframe.period, [high, low])

// Correlation / Dyad & Triad
corrDyadMode = input.string("Auto", "Corr Dyad Mode", options = ["Auto", "Manual"], group = "TORVEX • Correlation")
corrManualSym = input.string("", "Corr Manual Sym", group = "TORVEX • Correlation")
corrBackAdjust = input.bool(false, "Use ROC instead of raw close", group = "TORVEX • Correlation")
corrLookback = input.int(20, "Corr Lookback", group = "TORVEX • Correlation")
corrThreshold = input.float(0.6, "Corr Threshold", group = "TORVEX • Correlation")
corrTriadOn = input.string("Off", "Triad", options = ["Off", "On"], group = "TORVEX • Correlation")
corrThirdLeg = input.bool(true, "Use 3rd leg in Triad", group = "TORVEX • Correlation")

corrDyadSym  = corrDyadMode == "Auto" ? sym1 : corrManualSym
corrThirdSym = sym2

corrDyadClose  = request.security(corrDyadSym != "" ? corrDyadSym : syminfo.tickerid, timeframe.period, close, lookahead = barmerge.lookahead_off)
corrThirdClose = request.security(corrThirdSym != "" ? corrThirdSym : syminfo.tickerid, timeframe.period, close, lookahead = barmerge.lookahead_off)

corrSrcMain  = corrBackAdjust ? ta.roc(close, 1)          : close
corrSrcDyad  = corrBackAdjust ? ta.roc(corrDyadClose, 1)  : corrDyadClose
corrSrcThird = corrBackAdjust ? ta.roc(corrThirdClose, 1) : corrThirdClose

corrDyadR  = ta.correlation(corrSrcMain, corrSrcDyad, corrLookback)
corrThirdR = ta.correlation(corrSrcMain, corrSrcThird, corrLookback)

f_corrStatus(r) => r >= corrThreshold ? "ALIGNED" : r <= -corrThreshold ? "INVERTED" : "MIXED"
f_corrColor(s)  => s == "ALIGNED" ? color.green : s == "INVERTED" ? color.orange : color.gray

corrDyadStatus  = f_corrStatus(corrDyadR)
corrThirdStatus = f_corrStatus(corrThirdR)
corrTriadActive = corrTriadOn == "On" and corrThirdLeg
corrTriadStatus = not corrTriadActive ? "N/A" : (corrDyadStatus != "MIXED" and corrDyadStatus == corrThirdStatus ? "CONFIRMED" : "CONFLICT")

// Simple correlation table (optional)
showCorrTable = input.bool(true, "Show Corr Table", group = "TORVEX • Correlation")
f_panelSize() =>
    panelModeIn == "Mobile" ? size.tiny : size.small

var table corrTable = table.new(position.bottom_left, 2, 3, border_width = 1)
if showCorrTable and barstate.islast
    table.cell(corrTable, 0, 0, "CORRELATION", bgcolor = color.black, text_color = color.white, text_size = f_panelSize())
    table.cell(corrTable, 1, 0, "STATUS", bgcolor = color.black, text_color = color.white, text_size = f_panelSize())
    table.cell(corrTable, 0, 1, "DYAD", bgcolor = color.gray, text_color = color.white, text_size = f_panelSize())
    table.cell(corrTable, 1, 1, corrDyadStatus, bgcolor = f_corrColor(corrDyadStatus), text_color = color.white, text_size = f_panelSize())
    if corrTriadOn == "On"
        table.cell(corrTable, 0, 2, "TRIAD", bgcolor = color.gray, text_color = color.white, text_size = f_panelSize())
        table.cell(corrTable, 1, 2, corrTriadStatus, bgcolor = corrTriadStatus == "CONFIRMED" ? color.green : corrTriadStatus == "CONFLICT" ? color.red : color.gray, text_color = color.white, text_size = f_panelSize())

// SSMT tiers (Micro/90m/D/W/M/Q/Y)
compSym = sym1 != "" ? sym1 : syminfo.tickerid

f_ssmtTierFull(tf) =>
    [pH, pL] = request.security(syminfo.tickerid, tf, [high, low], lookahead = barmerge.lookahead_off)
    [cH, cL] = request.security(compSym, tf, [high, low], lookahead = barmerge.lookahead_off)
    inside  = pH <= pH[1] and pL >= pL[1]
    bullDiv = pH > pH[1] and cH < cH[1]
    bearDiv = pL < pL[1] and cL > cL[1]
    inside ? "SANDWICH • NO TRADE" : bullDiv ? "BULLISH" : bearDiv ? "BEARISH" : "NEUTRAL"

f_ssmtTierShared(tf, pH, pL) =>
    [cH, cL] = request.security(compSym, tf, [high, low], lookahead = barmerge.lookahead_off)
    inside  = pH <= pH[1] and pL >= pL[1]
    bullDiv = pH > pH[1] and cH < cH[1]
    bearDiv = pL < pL[1] and cL > cL[1]
    inside ? "SANDWICH • NO TRADE" : bullDiv ? "BULLISH" : bearDiv ? "BEARISH" : "NEUTRAL"

gMicroFix = "TORVEX • SSMT Micro Row"
smtMicroTF = input.timeframe("5", "Micro Row Fixed Timeframe (same reading on any chart TF)", group = gMicroFix, tooltip = "The Micro row used to just read the chart's own candles, so it showed something different on a 1m chart vs a 3m chart. Fixing it to one timeframe here makes it read identically no matter what timeframe you're viewing.")
[selfHiMicro, selfLoMicro] = request.security(syminfo.tickerid, smtMicroTF, [high, low], lookahead = barmerge.lookahead_off)
[compHiMicro, compLoMicro] = request.security(compSym, smtMicroTF, [high, low], lookahead = barmerge.lookahead_off)
ssmtMicroInside  = selfHiMicro <= selfHiMicro[1] and selfLoMicro >= selfLoMicro[1]
ssmtMicroBullDiv = selfHiMicro > selfHiMicro[1] and compHiMicro < compHiMicro[1]
ssmtMicroBearDiv = selfLoMicro < selfLoMicro[1] and compLoMicro > compLoMicro[1]
ssmtMicro = ssmtMicroInside ? "SANDWICH • NO TRADE" : ssmtMicroBullDiv ? "BULLISH" : ssmtMicroBearDiv ? "BEARISH" : "NEUTRAL"
ssmt90m = f_ssmtTierFull("90")
dH = request.security(syminfo.tickerid, "D", high, lookahead = barmerge.lookahead_off)
dL = request.security(syminfo.tickerid, "D", low, lookahead = barmerge.lookahead_off)
wH = request.security(syminfo.tickerid, "W", high, lookahead = barmerge.lookahead_off)
wL = request.security(syminfo.tickerid, "W", low, lookahead = barmerge.lookahead_off)
mH = request.security(syminfo.tickerid, "M", high, lookahead = barmerge.lookahead_off)
mL = request.security(syminfo.tickerid, "M", low, lookahead = barmerge.lookahead_off)
ssmtD   = f_ssmtTierShared("D", dH, dL)
ssmtW   = f_ssmtTierShared("W", wH, wL)
ssmtM   = f_ssmtTierShared("M", mH, mL)
ssmtQ   = f_ssmtTierFull("3M")
ssmtY   = f_ssmtTierFull("12M")

bullColStatus = color.green
bearColStatus = color.red
sandwichCol = color.orange
neutralColStatus = color.gray

f_ssmtColor(s) => s == "BULLISH" ? bullColStatus : s == "BEARISH" ? bearColStatus : s == "SANDWICH • NO TRADE" ? sandwichCol : neutralColStatus

// Alignment grade
gAlignGrade = "TORVEX • SSMT Alignment Grade"
showAlignGrade = input.bool(true, "Show A+/A++/A+++ Alignment Labels", group = gAlignGrade)
alignGradeMinCount = input.int(1, "Minimum HTFs Agreeing To Show A Label", minval = 1, maxval = 6, group = gAlignGrade)
alignGradeTextSize = input.string("Small", "Label Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = gAlignGrade)
alignGradeLineBars = input.int(10, "Leader Line Length (bars)", minval = 1, group = gAlignGrade)
alignGradeLineATR  = input.float(2.0, "Leader Line Height (x ATR)", minval = 0.1, group = gAlignGrade)

f_alignGradeSize(sz) =>
    sz == "Tiny" ? size.tiny : sz == "Normal" ? size.normal : sz == "Large" ? size.large : size.small

alignBullCount = (ssmt90m == "BULLISH" ? 1 : 0) + (ssmtD == "BULLISH" ? 1 : 0) + (ssmtW == "BULLISH" ? 1 : 0) + (ssmtM == "BULLISH" ? 1 : 0) + (ssmtQ == "BULLISH" ? 1 : 0) + (ssmtY == "BULLISH" ? 1 : 0)
alignBearCount = (ssmt90m == "BEARISH" ? 1 : 0) + (ssmtD == "BEARISH" ? 1 : 0) + (ssmtW == "BEARISH" ? 1 : 0) + (ssmtM == "BEARISH" ? 1 : 0) + (ssmtQ == "BEARISH" ? 1 : 0) + (ssmtY == "BEARISH" ? 1 : 0)

alignDir   = alignBullCount > alignBearCount ? "BULLISH" : alignBearCount > alignBullCount ? "BEARISH" : "NONE"
alignCount = math.max(alignBullCount, alignBearCount)

alignLeadTf = alignDir == "NONE" ? "" :
     ssmt90m == alignDir ? "90m" :
     ssmtD   == alignDir ? "D"   :
     ssmtW   == alignDir ? "W"   :
     ssmtM   == alignDir ? "M"   :
     ssmtQ   == alignDir ? "Q"   :
     ssmtY   == alignDir ? "Y"   : ""

f_alignTier(n) => n <= 1 ? "A" : n == 2 ? "A+" : n == 3 ? "A++" : "A+++"

alignATR = ta.atr(14)

var string alignPrevSig = ""
alignSig = alignDir + "|" + str.tostring(alignCount)
alignIsNew = alignDir != "NONE" and alignCount >= alignGradeMinCount and alignSig != alignPrevSig

if showAlignGrade and alignIsNew
    alignLabelTxt = f_alignTier(alignCount) + " " + alignLeadTf + " SSMT"
    alignLabelCol = alignDir == "BULLISH" ? bullColStatus : bearColStatus
    anchorY  = alignDir == "BULLISH" ? low : high
    lineX    = bar_index - alignGradeLineBars
    priceOff = alignATR * alignGradeLineATR
    lineY    = alignDir == "BULLISH" ? anchorY - priceOff : anchorY + priceOff
    label.new(bar_index, anchorY, "", style = label.style_circle, color = alignLabelCol, size = size.tiny)
    line.new(bar_index, anchorY, lineX, lineY, color = alignLabelCol, width = 1)
    label.new(lineX, lineY, alignLabelTxt, style = alignDir == "BULLISH" ? label.style_label_up : label.style_label_down, color = color.new(color.white, 100), textcolor = alignLabelCol, size = f_alignGradeSize(alignGradeTextSize))

if alignDir != "NONE" and alignCount >= alignGradeMinCount
    alignPrevSig := alignSig
else if alignDir == "NONE"
    alignPrevSig := ""

// ── TORVEX • OB Engine (light) & Master Panel (final chunk)
gOB = "TORVEX • OB Engine"
showOB = input.bool(false, "Show Order Blocks (light)", group = gOB)
obLookback = input.int(50, "OB Lookback", minval = 1, group = gOB)
obWidth = input.int(1, "OB Line Width", minval = 1, group = gOB)
obColBull = input.color(color.new(color.green, 20), "Bull OB", group = gOB)
obColBear = input.color(color.new(color.red, 20), "Bear OB", group = gOB)

f_findOB(lb) =>
    var float obBull = na
    var float obBear = na
    for i = 1 to lb
        if close[i] < open[i] and close > high[i]
            obBull := math.max(open[i], close[i])
        if close[i] > open[i] and close < low[i]
            obBear := math.min(open[i], close[i])
    [obBull, obBear]

if showOB
    [obB, obS] = f_findOB(obLookback)
    if not na(obB)
        line.new(bar_index - 1, obB, bar_index, obB, color = obColBull, width = obWidth, extend = extend.right)
    if not na(obS)
        line.new(bar_index - 1, obS, bar_index, obS, color = obColBear, width = obWidth, extend = extend.right)

gPANEL = "TORVEX • Master Panel"
showMasterPanel = input.bool(true, "Show Master Panel", group = gPANEL)
panelPos = input.string("Top Right", "Master Panel Position", options = ["Top Left", "Top Right", "Bottom Right", "Bottom Left"], group = gPANEL)
panelCols = input.color(color.rgb(18, 18, 24), "Panel Header", group = gPANEL)
panelRows = input.color(color.new(color.gray, 85), "Panel Rows", group = gPANEL)

f_pos(p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left

var table master = table.new(f_pos(panelPos), 4, 6, border_width = 1)
if barstate.islast and showMasterPanel
    table.cell(master, 0, 0, "TORVEX MASTER", bgcolor = panelCols, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 0, 1, "SSMT", bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 1, 1, alignDir == "NONE" ? "-" : alignDir, bgcolor = alignDir == "BULLISH" ? bullColStatus : alignDir == "BEARISH" ? bearColStatus : panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 0, 2, "BIAS H4/D/W/M", bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    // b_h4, b_d, b_w, b_m are placeholders for bias values — if modules exist they will fill
    f_biasText(x) => x == 1 ? "B" : x == -1 ? "S" : "-"
    b_h4 = 0
    b_d = 0
    b_w = 0
    b_m = 0
    table.cell(master, 1, 2, f_biasText(b_h4) + " / " + f_biasText(b_d) + " / " + f_biasText(b_w) + " / " + f_biasText(b_m), bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 0, 3, "TOB (Pending/Confirm)", bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    pendingCnt = 0
    confirmCnt = 0
    // tobBullBoxes etc. may be defined earlier in a full build; safe-guard here
    var array<box> tobBullBoxes = array.new<box>()
    var array<bool> tobBullInvalid = array.new<bool>()
    var array<bool> tobBullConfirmed = array.new<bool>()
    var array<box> tobBearBoxes = array.new<box>()
    var array<bool> tobBearInvalid = array.new<bool>()
    var array<bool> tobBearConfirmed = array.new<bool>()
    for bi = 0 to array.size(tobBullBoxes) - 1
        if not array.get(tobBullInvalid, bi)
            pendingCnt := pendingCnt + (array.get(tobBullConfirmed, bi) ? 0 : 1)
            confirmCnt := confirmCnt + (array.get(tobBullConfirmed, bi) ? 1 : 0)
    for bj = 0 to array.size(tobBearBoxes) - 1
        if not array.get(tobBearInvalid, bj)
            pendingCnt := pendingCnt + (array.get(tobBearConfirmed, bj) ? 0 : 1)
            confirmCnt := confirmCnt + (array.get(tobBearConfirmed, bj) ? 1 : 0)
    table.cell(master, 1, 3, "P:" + str.tostring(pendingCnt) + " C:" + str.tostring(confirmCnt), bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 0, 4, "CORR", bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 1, 4, corrDyadStatus + (corrTriadOn == "On" ? " / " + corrTriadStatus : ""), bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    // Key Level counts placeholders
    var array<line> tsBullKeyLines = array.new<line>()
    var array<line> tsBearKeyLines = array.new<line>()
    table.cell(master, 0, 5, "KEYS (Bull/Bear)", bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())
    table.cell(master, 1, 5, str.tostring(array.size(tsBullKeyLines)) + " / " + str.tostring(array.size(tsBearKeyLines)), bgcolor = panelRows, text_color = color.white, text_size = f_panelSize())

// Final housekeeping: trimming arrays that may grow
f_safeTrimArrays() =>
    while array.size(torvexZoneBoxes) > torvexMaxSets * 3
        box.delete(array.shift(torvexZoneBoxes))
        label.delete(array.shift(torvexZoneLabels))
        array.shift(torvexZoneTapped)
        array.shift(torvexZoneFrozen)
    // placeholder qcisd arrays in case missing
    var array<line> qcisdLines = array.new<line>()
    var array<label> qcisdLbls = array.new<label>()
    var array<int> qcisdAnchor = array.new<int>()
    var array<int> qcisdDir = array.new<int>()
    var array<bool> qcisdDead = array.new<bool>()
    var array<int> qcisdBar = array.new<int>()
    qcisdMaxActive = 50
    while array.size(qcisdLines) > qcisdMaxActive
        line.delete(array.shift(qcisdLines))
        label.delete(array.shift(qcisdLbls))
        array.shift(qcisdAnchor)
        array.shift(qcisdDir)
        array.shift(qcisdDead)
        array.shift(qcisdBar)

f_safeTrimArrays()

// End of TORVEX~DT
